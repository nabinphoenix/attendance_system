DATABASE_URL=postgresql://antimbench:antimbench@localhost:5433/antimbench
PROFILE_MEDIA_BUCKET=
PROFILE_MEDIA_PREFIX=profile-media
PROFILE_MEDIA_REGION=
# Optional local fallback. The Elastic Beanstalk service sets this automatically.
PROFILE_MEDIA_LOCAL_DIRECTORY=
JWT_SECRET_KEY=replace-with-a-secure-random-key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
AUTH_COOKIE_NAME=antimbench_session
# Set to true when the application is served over HTTPS in production.
AUTH_COOKIE_SECURE=false
GEOFENCE_RADIUS_METERS=150
GEOLOCATION_MAX_ACCURACY_METERS=100
ATTENDANCE_SELF_CHECKIN_WINDOW_MINUTES=15
ATTENDANCE_CHALLENGE_ROTATION_SECONDS=20
ATTENDANCE_CODE_LENGTH=5
ATTENDANCE_VERIFICATION_TIMEOUT_SECONDS=12
ATTENDANCE_MAX_CODE_ATTEMPTS=3
ATTENDANCE_THRESHOLD_PERCENT=75
MINIMUM_OBSERVATIONS=4
COLLEGE_NAME=Techspire College
# Required only when running app.seed after the multi-college migration. Never commit the password.
SUPER_ADMIN_EMAIL=superadmin@antimbench.example.com
SUPER_ADMIN_PASSWORD=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=notifications@antimbench.local
FRONTEND_URL=http://localhost:3000

# Calendar dates and feedback availability use this timezone.
ACADEMIC_TIMEZONE=Asia/Kathmandu

# Account security: interactive accounts lock after five consecutive bad passwords.
MAX_FAILED_LOGIN_ATTEMPTS=5
LOGIN_RATE_LIMIT=60
LOGIN_RATE_WINDOW_SECONDS=300
RESET_TOKEN_EXPIRE_MINUTES=15
RESET_REQUEST_IP_LIMIT=10
RESET_REQUEST_EMAIL_LIMIT=3
RESET_VERIFY_RATE_LIMIT=20
RESET_RATE_WINDOW_SECONDS=900
RESET_EMAIL_COOLDOWN_SECONDS=60
# FRONTEND_URL must point to the browser-facing URL; recovery reuses SMTP_* above.
